{
  "expo": {
    "name": "RoboMind",
    "slug": "RoboMind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons.jpg",
    "scheme": "robomind",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.robomind.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icons.jpg",
        "backgroundImage": "./assets/images/icons.jpg",
        "monochromeImage": "./assets/images/icons.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icons.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b9a9f0c6-ed02-4ceb-a130-b4da998f74d4"
      }
    }
  }
}
